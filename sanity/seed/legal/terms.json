          "markDefs": [],
          "children": [
            {
              "_type": "span",
              "_key": "kj",
              "text": "If you are using the site on behalf of a company, practice, or other organisation, for example as an interior designer or a developer enquiring for a client, you confirm you are authorised to accept these terms on its behalf, and “you” includes that organisation.",
              "marks": []
            }
