        },
        {
          "_type": "block",
          "_key": "k2r",
          "style": "normal",
          "markDefs": [],
          "children": [
            {
              "_type": "span",
              "_key": "k2q",
              "text": "If you send us an idea, suggestion, or feedback about our website or services, we may use it without restriction and without owing you anything for it. Please do not send us confidential or commercially sensitive information this way. This does not apply to project information you give us in the course of a signed engagement, which is governed by that contract.",
              "marks": []
