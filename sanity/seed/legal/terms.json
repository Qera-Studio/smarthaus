          "_type": "block",
          "_key": "k1m",
          "style": "normal",
          "listItem": "number",
          "level": 1,
          "markDefs": [],
          "children": [
            {
              "_type": "span",
              "_key": "k1l",
              "text": "we have issued a written proposal or quotation for that specific project; and",
              "marks": []
            }
          ]
        },
        {
          "_type": "block",
          "_key": "k1o",
          "style": "normal",
          "listItem": "number",
          "level": 1,
          "markDefs": [],
          "children": [
            {
              "_type": "span",
              "_key": "k1n",
              "text": "both parties have signed a written contract.",
              "marks": []
            }
          ]
        },
        {
          "_type": "block",
          "_key": "k1q",
          "style": "normal",
          "markDefs": [],
          "children": [
            {
              "_type": "span",
              "_key": "k1p",
              "text": "Until all three have happened, neither of us is committed. Submitting an enquiry does not oblige you to buy anything, and it does not oblige us to accept the work.",
