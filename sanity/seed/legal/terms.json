              "_type": "span",
              "_key": "k23",
              "text": "Privacy Policy",
              "marks": ["k22"]
            },
            {
              "_type": "span",
              "_key": "k24",
              "text": ".",
              "marks": []
            }
          ]
        }
      ]
    },
