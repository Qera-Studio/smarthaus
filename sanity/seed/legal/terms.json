        {
          "_type": "block",
          "_key": "kq",
          "style": "normal",
          "markDefs": [],
          "children": [
            {
              "_type": "span",
              "_key": "kp",
              "text": "Changes take effect when published, and apply to use of the site after that point. They do not change the terms of any contract already signed between us. If a change is material, we will make it apparent rather than relying on you re-reading the page.",
              "marks": []
            }
