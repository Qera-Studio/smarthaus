            }
          ]
        },
        {
          "_type": "block",
          "_key": "k1x",
          "style": "normal",
          "markDefs": [],
          "children": [
            {
              "_type": "span",
              "_key": "k1w",
              "text": "We aim to respond to every genuine enquiry. We cannot guarantee a response time, and we may decline an enquiry, for example where a project is outside the areas we serve, outside our technical scope, or outside our current capacity. We are not obliged to give a reason, though we usually will.",
              "marks": []
            }
          ]
        },
        {
          "_type": "block",
          "_key": "k1z",
          "style": "normal",
          "markDefs": [],
          "children": [
            {
              "_type": "span",
              "_key": "k1y",
              "text": "An enquiry is not a booking. A site visit is arranged by agreement between us, and arranging one commits neither party to a project.",
              "marks": []
            }
          ]
        },
        {
          "_type": "block",
          "_key": "k25",
          "style": "normal",
          "markDefs": [
