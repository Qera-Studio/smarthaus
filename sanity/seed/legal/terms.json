          "_type": "block",
          "_key": "k2j",
          "style": "normal",
          "markDefs": [],
          "children": [
            {
              "_type": "span",
              "_key": "k2i",
              "text": "The finished appearance of any installation depends on your property, the products selected, and what is agreed in your project documentation.",
              "marks": []
            }
          ]
        },
        {
          "_type": "block",
          "_key": "k2l",
          "style": "h3",
          "markDefs": [],
          "children": [
            {
              "_type": "span",
              "_key": "k2k",
              "text": "Third-party names and marks",
              "marks": []
            }
          ]
