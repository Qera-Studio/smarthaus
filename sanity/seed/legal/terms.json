    {
      "id": "not-an-offer",
      "title": "Information on this site is not an offer or a quotation",
      "short": "Not an offer or quotation",
      "body": [
        {
          "_type": "block",
          "_key": "k1g",
          "style": "normal",
          "markDefs": [],
          "children": [
            {
              "_type": "span",
              "_key": "k1d",
              "text": "Nothing on this website is an offer to sell, a quotation, or a commitment to supply at any particular price or on any particular timescale.",
              "marks": ["strong"]
            },
            {
              "_type": "span",
              "_key": "k1e",
              "text": " Prices, indicative costs, package descriptions, timelines, and capability descriptions are illustrative and may change.",
              "marks": []
            }
          ]
        },
        {
          "_type": "block",
          "_key": "k1i",
          "style": "normal",
          "markDefs": [],
          "children": [
            {
              "_type": "span",
              "_key": "k1h",
              "text": "A binding agreement between us comes into existence only when:",
              "marks": []
            }
          ]
        },
        {
          "_type": "block",
          "_key": "k1k",
          "style": "normal",
          "listItem": "number",
          "level": 1,
          "markDefs": [],
          "children": [
            {
              "_type": "span",
              "_key": "k1j",
              "text": "we have discussed your project and, where relevant, surveyed the property;",
              "marks": []
