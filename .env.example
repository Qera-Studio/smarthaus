# Smarthaus — Environment Variables
# Copy this file to .env.local and fill in real values.

# Public (exposed to the browser)
NEXT_PUBLIC_SITE_URL=https://smarthaus.ae
NEXT_PUBLIC_WHATSAPP_NUMBER=971543755150

# Lead capture (server-side only)
RESEND_API_KEY=
LEAD_EMAIL=contact@mapletech.ae
# Must be on a domain verified in Resend. No mailbox needs to exist.
LEAD_FROM_EMAIL=leads@smarthaus.ae

# Sanity CMS. The project and dataset are public: the Studio at /studio runs
# in the browser. The token is server-side only, for reads that need one.
NEXT_PUBLIC_SANITY_PROJECT_ID=nqc5m5ls
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=

# Vercel Analytics — auto-injected by Vercel, no manual config needed
