# Smarthaus — Environment Variables
# Copy this file to .env.local and fill in real values.

# Public (exposed to the browser)
NEXT_PUBLIC_SITE_URL=https://smarthaus.ae

# Lead capture (server-side only)
RESEND_API_KEY=
LEAD_EMAIL=contact@mapletech.ae
# Must be on a domain verified in Resend. No mailbox needs to exist.
LEAD_FROM_EMAIL=leads@smarthaus.ae

# Sanity CMS. All of the site's content (copy, pictures, the legal pages, the
# contact details and the WhatsApp number) is read from here at build time.
# The project and dataset are public: the Studio at /studio runs in the
# browser. Tests and CI read the "ci" dataset, a copy of sanity/seed/.
NEXT_PUBLIC_SANITY_PROJECT_ID=nqc5m5ls
NEXT_PUBLIC_SANITY_DATASET=production
# Server-only. The publish webhook's secret: the same value as in the webhook
# in sanity.io/manage. At least 32 random characters.
SANITY_REVALIDATE_SECRET=
# Server-only, a Viewer token: draft preview in the Studio. Never write access.
SANITY_API_TOKEN=

# Vercel Analytics — auto-injected by Vercel, no manual config needed
